# ---- Backend (role: API / data) ----
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foodbridge
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
AUDIT_API_KEY=change-me

# ---- Game client (role: gameplay) ----
VITE_API_URL=http://localhost:4000   # game only; the portal uses the Vite proxy

# ---- Web portal (role: dashboard) ----
# VITE_API_URL is shared; set it in each package's own .env if needed

# ---- Community audit (role: field data sync) ----
FOODBRIDGE_API_URL=http://localhost:4000
AUDIT_API_KEY=change-me
